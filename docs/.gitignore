# Godot 4 .gitignore

# Godot-spesifiset tiedostot
.godot/
*.uid

# Exportoidut buildit (älä commitoi binareja)
export/
builds/
*.exe
*.x86_64
*.arm64

# Editorin väliaikaiset tiedostot
*.tmp
*.bak
*.swp
*~

# OS-kohtaiset
.DS_Store
Thumbs.db
desktop.ini

# IDE / editorit
.vscode/
.idea/
*.suo
*.user

# Import-tiedostot (generoidaan automaattisesti)
.import/

# Steamworks SDK (älä commitoi, lisää manuaalisesti)
steamworks_sdk/
steam_api.dll
steam_api64.dll
libsteam_api.so
